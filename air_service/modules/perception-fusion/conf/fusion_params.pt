  great_similarity_score: 18
}

covariance_params {
  covariance_dim: 2
  default_camera_covariance: true
  occ_state_partial_magnification_x: 1.3
  occ_state_partial_magnification_y: 1
  occ_state_complete_magnification_x: 1.8
  occ_state_complete_magnification_y: 1
  trunc_state_partial_magnification_x: 1.4
  trunc_state_partial_magnification_y: 1
}

